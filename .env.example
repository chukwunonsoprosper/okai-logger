# Network
HOST=0.0.0.0
PORT=8080
REQUEST_TIMEOUT_MS=30000

# Logging
LOG_DIR=./logs
LOG_HEADERS=true
LOG_BODY=true
LOG_RESPONSE=true
# Comma-separated header names. Set REDACT_SENSITIVE_HEADERS=false only in a trusted environment.
REDACT_SENSITIVE_HEADERS=true
SENSITIVE_HEADERS=authorization,proxy-authorization,cookie,set-cookie,x-api-key

# Request capture
MAX_BODY_SIZE=10mb

# Optional native HTTPS listener. HTTP remains available on HOST:PORT.
HTTPS_ENABLED=false
TLS_KEY_PATH=
TLS_CERT_PATH=
HTTPS_PORT=8443
